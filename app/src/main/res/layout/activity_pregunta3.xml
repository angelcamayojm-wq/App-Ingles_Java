<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/fondo9"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo35"
        android:textSize="37sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="@color/red"
        android:gravity="center" />

    <ImageView
        android:onClick="sonarpregunta3"
        android:layout_width="250dp"
        android:layout_height="190dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/pregunta3" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="140dp"
            android:onClick="sonarincorrecto"
            android:src="@drawable/letraa" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="140dp"
            android:layout_marginStart="50dp"
            android:onClick="sonarincorrecto"
            android:src="@drawable/letrae" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="140dp"
            android:contentDescription="Opción 3"
            android:onClick="sonarincorrecto"
            android:src="@drawable/letrai" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="140dp"
            android:layout_marginStart="50dp"
            android:onClick="sonarcorrecto"
            android:src="@drawable/letrao" />

        <!-- La U centrada debajo de las demás -->
        <ImageView
            android:id="@+id/opcion4"
            android:layout_width="150dp"
            android:layout_height="140dp"
            android:layout_columnSpan="2"
            android:layout_gravity="center_horizontal"
            android:onClick="sonarincorrecto"
            android:src="@drawable/letrau" />

    </GridLayout>

</LinearLayout>
