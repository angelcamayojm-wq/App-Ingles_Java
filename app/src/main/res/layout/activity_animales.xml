<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo5"
        android:scaleType="centerCrop"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">


            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tituloanimales"
                android:onClick="sonaranimales"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="40dp" />

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                >

                <TextView
                    android:id="@+id/txtVaca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo13"
                    android:textColor="@color/orange"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/vaca"
                    android:onClick="sonarvaca"
                    android:layout_marginEnd="40dp"
                    android:layout_marginStart="58dp"
                    />



            </LinearLayout>


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtPerro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo14"
                    android:textColor="@color/verdeoscuro"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/perro"
                    android:onClick="sonarperro"
                    android:layout_marginEnd="50dp"
                    android:layout_marginStart="55dp"/>



            </LinearLayout>
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtGato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo15"
                    android:textColor="@color/blue"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/gato"
                    android:onClick="sonargato"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="60dp"/>



            </LinearLayout>
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtCerdo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo16"
                    android:textColor="@color/purple"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView

                    android:id="@+id/imgCerdo"
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="50dp"
                    android:onClick="sonarcerdo"
                    android:src="@drawable/cerdo"
                    android:layout_marginStart="55dp"
                    />


            </LinearLayout>
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/txtConejo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo17"
                    android:textColor="@color/black"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgConejito"
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/conejo"
                    android:onClick="sonarconejo"
                    android:layout_marginEnd="100dp"
                    android:layout_marginStart="38dp"/>



            </LinearLayout>

            <Button
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/red"
                android:onClick="volver"
                android:text="⬅ VOLVER"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />



        </LinearLayout>
    </ScrollView>
</FrameLayout>