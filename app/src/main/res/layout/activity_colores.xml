<?xml version="1.0" encoding="utf-8"?>


<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo3"
        android:scaleType="centerCrop"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">


            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulocolores"
                android:onClick="sonarcolores"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="40dp" />

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                >

                <TextView
                    android:id="@+id/txtverde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo11"
                    android:textColor="@color/verdeoscuro"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/verde"
                    android:onClick="sonarVerde"
                    android:layout_marginEnd="40dp"
                    android:layout_marginStart="40dp"
                    />



            </LinearLayout>


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtazul"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo9"
                    android:textColor="@color/blue"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/blue"
                    android:onClick="sonarazul"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="75dp"/>



            </LinearLayout>
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtnaranja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo12"
                    android:textColor="@color/orange"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/naranja"
                    android:onClick="sonarnaranja"
                    android:layout_marginEnd="20dp"
                    android:layout_marginStart="18dp"/>



            </LinearLayout>
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtrojo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo10"
                    android:textColor="@color/red"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="50dp"
                    android:src="@drawable/rojo"
                    android:onClick="sonarrojo"
                    android:layout_marginStart="80dp"
                    />


            </LinearLayout>
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/txtmorado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo8"
                    android:textColor="@color/purple"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:src="@drawable/morado"
                    android:onClick="sonarmorado"
                    android:layout_marginEnd="100dp"
                    android:layout_marginStart="38dp"/>



            </LinearLayout>

            <Button
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/red"
                android:onClick="volver"
                android:text="⬅ VOLVER"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />



        </LinearLayout>
    </ScrollView>
</FrameLayout>


