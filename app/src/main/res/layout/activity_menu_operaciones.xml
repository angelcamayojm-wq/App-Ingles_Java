<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo2"
        android:scaleType="centerCrop"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txtoperaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Operaciones"
                android:onClick="sonarmenuprincipal"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:background="#CCFFFFFF"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtsuma"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/Sumar"
                    android:onClick="sonarsuma"
                    android:textColor="@color/blue"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    android:onClick="irsuma"
                    android:src="@drawable/paletacolores"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:background="#CCFFFFFF"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtresta"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/Restar"
                    android:onClick="sonarrestar"
                    android:textColor="@color/verdeoscuro"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    android:onClick="irrestar"
                    android:src="@drawable/iconoanimal"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:background="#CCFFFFFF"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtmultiplicar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/Multiplicar"
                    android:onClick="sonarmultiplicar"
                    android:textColor="@color/orange"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/iconovocales"
                    android:onClick="irmultiplicacion"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:background="#CCFFFFFF"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtdividir"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/Dividir"
                    android:onClick="sonardividir"
                    android:textColor="@color/purple"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    android:onClick="irdivision"
                    android:src="@drawable/icononumeros"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <Button
                android:layout_width="200dp"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/red"
                android:onClick="volver"
                android:text="⬅ VOLVER"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
