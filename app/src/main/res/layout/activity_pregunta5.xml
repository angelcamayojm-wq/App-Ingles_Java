<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/fondo7"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo37"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="@color/red"
        android:gravity="center" />

    <ImageView
        android:layout_width="334dp"
        android:layout_height="190dp"
        android:layout_marginBottom="24dp"
        android:onClick="sonarpregunta5"
        android:src="@drawable/calculadora" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="124dp"
            android:onClick="sonarincorrecto"
            android:src="@drawable/icono1" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="127dp"
            android:layout_marginStart="50dp"
            android:onClick="sonarincorrecto"
            android:src="@drawable/icono2" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="122dp"
            android:contentDescription="Opción 3"
            android:onClick="sonarcorrecto"
            android:src="@drawable/icono3" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_marginStart="50dp"
            android:onClick="sonarincorrecto"
            android:src="@drawable/icono4" />

        <!-- La U centrada debajo de las demás -->
        <ImageView
            android:id="@+id/opcion4"
            android:layout_width="150dp"
            android:layout_height="116dp"
            android:layout_columnSpan="2"
            android:layout_gravity="center_horizontal"
            android:onClick="sonarincorrecto"
            android:src="@drawable/icono5" />

    </GridLayout>

</LinearLayout>
